# SENTINEL AI - Environment Configuration Template

# Node Backend
PORT=5000
SERVER_PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sentinel_soc
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120

# Optional External LLM Provider (OpenAI, Gemini, OpenRouter)
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=gpt-4o-mini
